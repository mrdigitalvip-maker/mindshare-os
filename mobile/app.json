{
  "expo": {
    "name": "KIVRYN",
    "owner": "brunobrandao",
    "slug": "nexora-native",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kivryn",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "kivryn.app",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "kivryn"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "icon": "./assets/branding/nexora-app-icon-master.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/nexora-app-icon-master.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que a KIVRYN acesse a foto escolhida para análise.",
          "cameraPermission": "Permita que a KIVRYN use a câmera para fotografar."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "307c1e13-5eb2-41fc-99ea-27f2ef392ff7"
      }
    },
    "icon": "./assets/branding/nexora-app-icon-master.png"
  }
}

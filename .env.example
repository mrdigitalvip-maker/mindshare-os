VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Only these VITE_ values are shipped to the browser. Never add private provider keys here.
# Mock services are opt-in and never activate automatically after a live request fails.
VITE_DEMO_MODE=false

# Creator OAuth server-only configuration (values are never shipped to mobile/browser)
CREATOR_TOKEN_ENCRYPTION_KEY=
CREATOR_OAUTH_REDIRECT_ALLOWLIST=
CREATOR_SYNC_SCHEDULER_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Supabase Edge Function secrets/configuration (set with `supabase secrets set`; never VITE_)
# Canonical production origin. Keep Supabase Site URL, auth redirects, Stripe
# return URLs, the TWA default URL, and Digital Asset Links on this origin.
APP_URL=https://nexora.app
VITE_PUBLIC_SITE_URL=https://nexora.app
OPENAI_API_KEY=
OPENAI_FREE_MODEL=
OPENAI_PREMIUM_MODEL=
FREE_DAILY_MESSAGE_LIMIT=10
PREMIUM_DAILY_MESSAGE_LIMIT=100
FREE_MAX_INPUT_CHARS=2000
PREMIUM_MAX_INPUT_CHARS=12000
FREE_MAX_OUTPUT_TOKENS=400
PREMIUM_MAX_OUTPUT_TOKENS=1600
FREE_CONTEXT_MESSAGES=8
PREMIUM_CONTEXT_MESSAGES=30
FREE_CONTEXT_CHARS=8000
PREMIUM_CONTEXT_CHARS=40000
OPENAI_TIMEOUT_MS=30000
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=price_monthly_placeholder
STRIPE_WEBHOOK_SECRET=
# Kept for Stripe client integrations; the current hosted Checkout flow does not read it.
STRIPE_PUBLISHABLE_KEY=
# Supabase supplies these automatically to deployed Edge Functions. List names here only as a checklist.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Reserved for a future schema-backed automatic trial. It is not currently applied.
TRIAL_DAYS=7

# Web Push: public browser key only. Keep VAPID_PRIVATE_KEY in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=
